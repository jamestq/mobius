{
  "permissions": {
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep|Glob|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/setup.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/protector/protect-env.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/enforcer/enforce-explorer.sh"
          },
          {
            "type": "command",
            "command": "/workspace/.claude/hooks/enforcer/enforce-architect.sh"
          }
        ]
      }
    ]
  },
  "prefersReducedMotion": true
}
