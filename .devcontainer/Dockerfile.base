FROM python:3.13-bookworm

ARG TZ
ENV TZ="$TZ"

# Install basic development tools and Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
  git \
  gh \
  unzip \
  less \
  procps \  
  neovim \
  fzf \
  zsh \
  curl \
  ca-certificates \
  sudo \
  # Install networking tools for firewall management
  iptables \
  iproute2 \
  ipset \
  dnsutils \
  aggregate \
  jq \
  # Neovim/kickstart dependencies
  ripgrep \
  fd-find \
  make \
  gcc \
  # OpenCV dependencies
  libgl1 \
  libglib2.0-0 \
  libsm6 \
  libxext6 \
  libxrender1 \
  libgomp1 \
  # Docker dependencies
  docker.io \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Add GitHub CLI source
RUN (type -p wget >/dev/null || (apt update && apt install wget -y)) \
	&& mkdir -p -m 755 /etc/apt/keyrings \
	&& out=$(mktemp) && wget -nv -O$out https://cli.github.com/packages/githubcli-archive-keyring.gpg \
	&& cat $out | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
	&& chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
	&& mkdir -p -m 755 /etc/apt/sources.list.d \
	&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null

# Create dev user with sudo access
RUN useradd -m -s /bin/zsh -G sudo dev \
  && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
  && chmod 0440 /etc/sudoers.d/dev

# Persist bash history for dev user
RUN mkdir -p /commandhistory \
  && touch /commandhistory/.bash_history \
  && chown -R dev:dev /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

ARG GIT_DELTA_VERSION=0.18.2
RUN ARCH=$(dpkg --print-architecture) && \
  curl -fsSL -O "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# Configure git to use gh as credential helper for HTTPS repos (uses GH_TOKEN at runtime)
RUN git config --system credential.https://github.com.helper '!/usr/bin/gh auth git-credential'

# Set the default shell to zsh rather than sh
ENV SHELL=/bin/zsh

# Set the default editor and visual
ENV EDITOR=nvim
ENV VISUAL=nvim

# Create workspace directory with proper ownership
RUN mkdir -p /workspace && chown -R dev:dev /workspace

# Switch to dev user for installations
USER dev
ENV HOME=/home/dev

# Install nvm and Node.js 24
ENV NVM_DIR="$HOME/.nvm"
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
  && \. "$NVM_DIR/nvm.sh" \
  && nvm install 24

# Install poetry and configure for minimal cache footprint
RUN curl -sSL https://install.python-poetry.org | python3 \
  && $HOME/.local/bin/poetry config virtualenvs.in-project true \
  && $HOME/.local/bin/poetry config cache-dir /home/dev/.cache/pypoetry

# Install Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash  
RUN echo 'source /usr/share/doc/fzf/examples/key-bindings.zsh' >> ~/.zshrc \
  && echo 'source /usr/share/doc/fzf/examples/completion.zsh' >> ~/.zshrc \
  && echo 'export PROMPT_COMMAND="history -a" && export HISTFILE=/commandhistory/.bash_history' >> ~/.zshrc  

  # Install starship
RUN curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin" 2>&1

# Install kickstart.nvim
RUN git clone https://github.com/jamestq/kickstart.nvim.git "${XDG_CONFIG_HOME:-$HOME/.config}"/nvim \
  && nvim --headless "+Lazy! sync" +qa

# Add poetry, nvm, npm, Claude Code to PATH, and load nvm
RUN echo 'export PATH="$HOME/.local/bin:$PATH"' >> $HOME/.zshrc \
  && echo 'export NVM_DIR="$HOME/.nvm"' >> $HOME/.zshrc \
  && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> $HOME/.zshrc \
  && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"' >> $HOME/.zshrc \  
  && echo 'export PATH="$HOME/.local/bin:$PATH"' >> $HOME/.bashrc \
  && echo 'export NVM_DIR="$HOME/.nvm"' >> $HOME/.bashrc \
  && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> $HOME/.bashrc \
  && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"' >> $HOME/.bashrc \
  && echo 'eval "$(starship init zsh)"' >> ~/.zshrc


# Add a Claude alias that appends the repo-level SYSTEM prompt automatically
RUN echo "alias claudep='claude --append-system-prompt .claude/SYSTEM.md'" >> $HOME/.zshrc \
  && echo "alias claudep='claude --append-system-prompt .claude/SYSTEM.md'" >> $HOME/.bashrc

  # Install pre-commit globally
RUN pip install --user pre-commit

# Clean up pip and poetry caches to reduce image size
RUN pip cache purge 2>/dev/null || true \
  && $HOME/.local/bin/poetry cache clear --all . 2>/dev/null || true \
  && rm -rf $HOME/.cache/pip

WORKDIR /workspace
