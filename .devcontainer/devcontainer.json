{
  "name": "Development Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE_IMAGE": "devcontainer-base:latest"
    }
  },
  "features":{
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "runArgs": [
    // "--gpus=all", // This enable gpu usage   
    "--env-file", ".devcontainer/.env" // Passes as ENV to container
  ],
  "customizations": {
    "vscode": {
      "extensions": [ // extensions from VSCode
        // "dbaeumer.vscode-eslint", // Uncomment this for JS/TS linters and formatters
        // "esbenp.prettier-vscode",
        "ms-python.black-formatter",
        "eamodio.gitlens",
        "ms-python.python",
        "github.github-vscode-theme"
      ],
      "settings": {
        "workbench.colorTheme": "GitHub Dark Default",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "python.analysis.typeCheckingMode": "standard",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "dev",
  "mounts": [
    "source=claude-code-bashhistory-${localWorkspaceFolderBasename},target=/commandhistory,type=volume",
    "source=dev-config-${localWorkspaceFolderBasename},target=/home/dev,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=poetry-cache,target=/home/dev/.cache/pypoetry,type=volume",
    "source=npm-cache,target=/home/dev/.npm,type=volume",
    "source=pip-cache,target=/home/dev/.cache/pip,type=volume",
    "source=claude-config,target=/home/dev/.claude,type=volume",
  ],
  "containerEnv": {
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "POETRY_VIRTUALENVS_IN_PROJECT": "true",
    "BASH_ENV": "/workspace/.claude/project-env.sh"
  },
  "forwardPorts": [8000, 8001, 3000, 3001, ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/entry.sh",
  "updateRemoteUserUID": true
}
