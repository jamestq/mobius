{
  "name": "Development Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE_IMAGE": "devcontainer-base:latest"
    }
  },
  "features":{
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "runArgs": [
    // "--gpus=all", // This enable gpu usage
    // These enable firewall settings
    "--env-file", ".devcontainer/.env" // Passes env variables from a file to the container
  ],
  "customizations": {
    "vscode": {
      "extensions": [ // extensions from VSCode
        // "dbaeumer.vscode-eslint", // Uncomment this for JS/TS linters and formatters
        // "esbenp.prettier-vscode",
        "ms-python.black-formatter",
        "eamodio.gitlens",
        "ms-python.python",
        "github.github-vscode-theme"
      ],
      "settings": {
        "workbench.colorTheme": "GitHub Dark Default",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "python.analysis.typeCheckingMode": "standard",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "dev",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=dev-config-${devcontainerId},target=/home/dev,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=poetry-cache,target=/home/dev/.cache/pypoetry,type=volume",    
  ],
  "containerEnv": {
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "POETRY_VIRTUALENVS_IN_PROJECT": "true"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sudo chown -R dev:dev /home/dev/.claude 2>/dev/null; test -f ~/.claude.json && jq '.mcpServers.context7 = {\"type\": \"stdio\", \"command\": \"npx\", \"args\": [\"-y\", \"@upstash/context7-mcp\", \"--api-key\", env.CONTEXT7]}' ~/.claude.json > /tmp/claude.json && mv /tmp/claude.json ~/.claude.json",
  "updateRemoteUserUID": true
}
